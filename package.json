{
  "name": "@usevibejs/vibecn",
  "version": "0.0.0",
  "private": true,
  "description": "An independent port of shadcn/ui components for vibe.js, distributed as source code.",
  "license": "MIT",
  "bin": {
    "vibecn": "./dist/bin.js"
  },
  "files": [
    "dist",
    "registry",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "dev": "vite playground --host 127.0.0.1",
    "build": "tsdown && node scripts/build-registry.ts && vite build playground",
    "typecheck": "tsc -b tsconfig.tools.json && pnpm --dir playground exec tsc -b --runExternalCode",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "test": "vitest run --project unit --project components",
    "test:coverage": "vitest run --coverage --project unit --project components",
    "test:integration": "pnpm build && vitest run --project integration",
    "check": "oxfmt --check && pnpm typecheck && pnpm lint && pnpm test:coverage",
    "prepare:playground": "node scripts/prepare-playground.ts",
    "predev": "pnpm prepare:playground",
    "prebuild": "pnpm prepare:playground",
    "precheck": "pnpm prepare:playground"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@usevibejs/compiler": "catalog:",
    "@usevibejs/language-tools": "catalog:",
    "@usevibejs/ui": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "clsx": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "packageManager": "pnpm@12.14.0"
}
