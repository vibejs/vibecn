{
  "name": "@usevibejs/vibecn",
  "version": "0.3.0",
  "description": "An independent port of shadcn/ui components for vibe.js, distributed as source code.",
  "keywords": [
    "cli",
    "components",
    "registry",
    "shadcn",
    "tailwindcss",
    "ui",
    "vibejs"
  ],
  "homepage": "https://vibecn.dev/docs",
  "bugs": {
    "url": "https://github.com/vibejs/vibecn/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibejs/vibecn.git"
  },
  "bin": {
    "vibecn": "./dist/bin.js"
  },
  "files": [
    "dist",
    "registry",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite site --host 127.0.0.1",
    "build": "tsdown && node scripts/build-registry.ts && vite build site",
    "typecheck": "tsc -b tsconfig.tools.json && pnpm --dir site exec tsc -b --runExternalCode",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "test": "vitest run --project unit --project components",
    "test:coverage": "vitest run --coverage --project unit --project components",
    "test:integration": "pnpm build && vitest run --project integration",
    "check": "oxfmt --check && pnpm typecheck && pnpm lint && pnpm test:coverage",
    "predev": "pnpm prepare:site",
    "prebuild": "pnpm prepare:site",
    "precheck": "pnpm prepare:site",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "prepare:site": "node scripts/prepare-site.ts"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@usevibejs/compiler": "catalog:",
    "@usevibejs/language-tools": "catalog:",
    "@usevibejs/ui": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "clsx": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "packageManager": "pnpm@12.14.0"
}
