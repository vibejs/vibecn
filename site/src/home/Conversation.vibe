<script setup lang="ts">
import { ref } from '@usevibejs/ui';
import Avatar from '@/components/ui/Avatar.vibe';
import AvatarFallback from '@/components/ui/AvatarFallback.vibe';
import Bubble from '@/components/ui/Bubble.vibe';
import BubbleContent from '@/components/ui/BubbleContent.vibe';
import Button from '@/components/ui/Button.vibe';
import Input from '@/components/ui/Input.vibe';
import Message from '@/components/ui/Message.vibe';
import MessageContent from '@/components/ui/MessageContent.vibe';
const message = ref('');
const messages = ref(['A component library with a little personality?']);
function send(): void { if (message.value.trim()) { messages.value = [...messages.value, message.value.trim()]; message.value = ''; } }
</script>
<template><div class="w-full"><div class="mb-5 flex items-center gap-2.5"><Avatar size="sm"><AvatarFallback>JL</AvatarFallback></Avatar><div><p class="text-sm font-medium">Jamie</p><p class="text-xs text-muted-foreground">Your next collaborator</p></div><span class="ml-auto text-xs text-muted-foreground">Just now</span></div><div class="grid max-h-64 gap-3 overflow-y-auto pb-5"><Message><MessageContent><Bubble variant="muted"><BubbleContent>Hey! What are we making today? 👋</BubbleContent></Bubble></MessageContent></Message><Message v-for="(text, index) in messages" :key="index" align="end"><MessageContent><Bubble><BubbleContent>{{ text }}</BubbleContent></Bubble></MessageContent></Message></div><form class="flex gap-2 border-t border-border pt-4" @submit.prevent="send"><Input v-model="message" aria-label="Your message" placeholder="A good idea starts here…" /><Button type="submit" size="icon" aria-label="Send message" :disabled="!message.trim()">↑</Button></form></div></template>
