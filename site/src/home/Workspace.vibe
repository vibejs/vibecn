        <TabsContent value="overview" class="home-workspace-panel"><div class="home-workspace-metrics"><div><p>Total visitors</p><strong>12,846<span>↗ 18.6%</span></strong></div><Badge variant="outline" class="self-start">This week</Badge></div><Chart type="area" label="Your ideas, picking up momentum" :data="visitors" class="home-workspace-chart" /><div class="home-workspace-bottom"><AvatarGroup><Avatar v-for="member in members" :key="member.initials" size="sm"><AvatarFallback>{{ member.initials }}</AvatarFallback></Avatar></AvatarGroup><span>Made better, together.</span><span class="ml-auto">7 days</span></div></TabsContent>
