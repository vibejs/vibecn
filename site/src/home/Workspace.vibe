const visitors = [{ label: 'Mon', value: 24 }, { label: 'Tue', value: 42 }, { label: 'Wed', value: 35 }, { label: 'Thu', value: 64 }, { label: 'Fri', value: 56 }, { label: 'Sat', value: 83 }, { label: 'Sun', value: 96 }];
function invite(): void { toast.success(`Invitation sent to ${email.value}`); sharing.value = false; email.value = ''; }
