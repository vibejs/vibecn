<script setup lang="ts">
import { computed, ref } from '@usevibejs/ui';
import { RouterLink } from '@usevibejs/ui/router';
import Select from '@/components/ui/Select.vibe';
import SelectContent from '@/components/ui/SelectContent.vibe';
import SelectItem from '@/components/ui/SelectItem.vibe';
import SelectTrigger from '@/components/ui/SelectTrigger.vibe';
import SelectValue from '@/components/ui/SelectValue.vibe';
import Tabs from '@/components/ui/Tabs.vibe';
import TabsContent from '@/components/ui/TabsContent.vibe';
import TabsList from '@/components/ui/TabsList.vibe';
import TabsTrigger from '@/components/ui/TabsTrigger.vibe';
import { views } from '../home/views.ts';
import CopyButton from '../site/CopyButton.vibe';
import { componentCount, sections } from '../site/nav.ts';

document.title = 'vibecn · Components for vibe.js';
const command = 'pnpm dlx @usevibejs/vibecn@latest init';
const view = ref('cards');

// The default is shadcn/ui's neutral theme; the others only recolor the showcase.
const theme = ref('neutral');
const themes: Record<string, Record<string, string>> = {
  neutral: {},
  blue: { '--primary': 'oklch(0.546 0.245 262.881)', '--primary-foreground': 'oklch(0.985 0 0)', '--ring': 'oklch(0.623 0.214 259.815)' },
  green: { '--primary': 'oklch(0.527 0.154 150.069)', '--primary-foreground': 'oklch(0.985 0 0)', '--ring': 'oklch(0.627 0.194 149.214)' },
  rose: { '--primary': 'oklch(0.586 0.253 17.585)', '--primary-foreground': 'oklch(0.985 0 0)', '--ring': 'oklch(0.645 0.246 16.439)' },
  violet: { '--primary': 'oklch(0.541 0.281 293.009)', '--primary-foreground': 'oklch(0.985 0 0)', '--ring': 'oklch(0.606 0.25 292.717)' },
};
const themeStyle = computed(() => themes[theme.value]);
const components = sections.find((section) => section.title === 'Components')!.items;
</script>

<template>
  <div class="flex flex-col">
    <section class="mx-auto flex w-full max-w-3xl flex-col items-center gap-5 px-4 pt-16 pb-10 text-center sm:pt-24" aria-labelledby="home-title">
      <RouterLink
