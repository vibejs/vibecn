<script setup lang="ts">
import { computed, ref } from '@usevibejs/ui';
import { RouterLink } from '@usevibejs/ui/router';
import Playground from '../home/Playground.vibe';
import Workspace from '../home/Workspace.vibe';
import CopyButton from '../site/CopyButton.vibe';
import Icon from '../site/Icon.vibe';
import { componentCount } from '../site/nav.ts';
import logo from '../assets/vibecn-logo.webp';
import '../home.css';

document.title = 'vibecn · A whole new vibe for your interface';
const command = 'pnpm dlx @usevibejs/vibecn@latest init';
const accent = ref('cobalt');
const colors = [ { name: 'cobalt', label: 'Cobalt', color: '#3c55e8' }, { name: 'forest', label: 'Forest', color: '#187a65' }, { name: 'rose', label: 'Rose', color: '#b74768' }, { name: 'ink', label: 'Ink', color: '#30343d' } ];
const palettes: Record<string, Record<string, string>> = {
  cobalt: { '--primary': '#3c55e8', '--primary-foreground': '#ffffff', '--ring': '#8191eb', '--chart-1': '#3c55e8', '--chart-2': '#6d83e8', '--chart-3': '#79bda7', '--chart-4': '#d7a866', '--chart-5': '#ba9de5' },
  forest: { '--primary': '#187a65', '--primary-foreground': '#ffffff', '--ring': '#76b9a9', '--chart-1': '#187a65', '--chart-2': '#479d88', '--chart-3': '#89c6af', '--chart-4': '#d7b96b', '--chart-5': '#769da8' },
  rose: { '--primary': '#b74768', '--primary-foreground': '#ffffff', '--ring': '#d593a5', '--chart-1': '#b74768', '--chart-2': '#ce7c94', '--chart-3': '#dfabba', '--chart-4': '#e5b989', '--chart-5': '#aa92c1' },
  ink: { '--primary': '#30343d', '--primary-foreground': '#ffffff', '--ring': '#90959e', '--chart-1': '#30343d', '--chart-2': '#656b76', '--chart-3': '#939aa6', '--chart-4': '#b5bac3', '--chart-5': '#d2d6dd' },
};
const palette = computed(() => palettes[accent.value]);
const principles = [
  { symbol: '</>', title: 'Your code. Your call.', text: 'Copy the .vibe source into your app. Read it, change it, and make it feel like you.' },
  { symbol: '⌘', title: 'Feels right by default.', text: 'Native controls, thoughtful focus behavior, and keyboard support built into the details.' },
  { symbol: '◐', title: 'A theme of your own.', text: 'A few CSS variables set the tone. Light and dark modes are ready when you are.' },
];
</script>

<template>
  <div class="homepage" :style="palette">
    <section class="home-hero home-container" aria-labelledby="home-heading">
      <div class="home-hero-copy">
        <RouterLink to="/docs" class="home-intro-pill"><span class="home-pill-dot" aria-hidden="true" />Open source. Open to possibility.<Icon name="arrow-right" /></RouterLink>
        <h1 id="home-heading">Familiar pieces.<br />A whole new <span>vibe.</span></h1>
        <p class="home-hero-description">The shadcn/ui you love, made for <a href="https://vibejs.org">vibe.js</a>.<br class="hidden sm:block" /> Beautiful, accessible components you can copy,<br class="hidden xl:block" /> shape, and make entirely your own.</p>
        <div class="home-hero-actions"><RouterLink to="/docs/installation" class="home-button home-button-primary">Start building<Icon name="arrow-right" /></RouterLink><a href="#playground" class="home-button home-button-secondary">Explore the playground<span aria-hidden="true">↓</span></a></div>
        <div class="home-install"><span class="home-install-prompt" aria-hidden="true">$</span><code>{{ command }}</code><CopyButton :value="command" label="Copy install command" /></div>
        <div class="home-hero-footnote"><span>{{ componentCount }} component pages</span><i aria-hidden="true" /><span>MIT licensed</span><i aria-hidden="true" /><span>Yours to build with</span></div>
      </div>
      <Workspace />
    </section>
    <section class="home-materials home-container" aria-label="Built from familiar foundations"><span>A familiar foundation.<br /><strong>A fresh way to build.</strong></span><div><span class="home-material-wordmark">shadcn/ui</span><span class="home-material-plus" aria-hidden="true">+</span><span class="home-material-wordmark home-vibe-wordmark">vibe<span>.js</span></span><span class="home-material-plus" aria-hidden="true">=</span><span class="home-material-wordmark home-material-brand"><img class="dark:invert" :src="logo" alt="" width="32" height="32" decoding="async" />vibecn</span></div><a href="https://github.com/vibejs/vibecn" class="home-source-link">The source is yours<Icon name="arrow-right" /></a></section>
    <div class="home-container"><div class="home-accent-bar"><span><span aria-hidden="true">◒</span> A different color. A different feeling.</span><div role="group" aria-label="Preview accent color"><button v-for="color in colors" :key="color.name" type="button" :aria-label="color.label + ' accent'" :aria-pressed="accent === color.name" :style="{ '--swatch': color.color }" @click="accent = color.name"><span aria-hidden="true" />{{ color.label }}</button></div></div><Playground /></div>
    <section class="home-principles"><div class="home-container home-principles-grid"><div v-for="principle in principles" :key="principle.title"><span class="home-principle-symbol" aria-hidden="true">{{ principle.symbol }}</span><h2>{{ principle.title }}</h2><p>{{ principle.text }}</p></div></div></section>
    <section class="home-outro home-container"><p class="home-eyebrow">FROM A SMALL IDEA TO SOMETHING REAL</p><h2>Your next interface<br />is already taking shape.</h2><p>Take the pieces you need. Leave room for your own ideas.</p><div class="home-hero-actions"><RouterLink to="/docs/installation" class="home-button home-button-primary">Make a start<Icon name="arrow-right" /></RouterLink><a href="https://github.com/vibejs/vibecn" class="home-button home-button-secondary"><Icon name="github" />Explore the source</a></div><span class="home-outro-signature">Good things are made of little things.</span></section>
  </div>
</template>
