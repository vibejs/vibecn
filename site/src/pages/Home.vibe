        class="inline-flex items-center gap-2 rounded-full border bg-background px-3 py-1 text-xs font-medium shadow-xs transition-colors hover:bg-accent"
      >
        <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true" />
        New: chat components
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-3 text-muted-foreground"><path d="m9 18 6-6-6-6" /></svg>
      </RouterLink>
      <h1 id="home-title" class="max-w-2xl text-4xl leading-tight font-semibold tracking-tight text-balance lg:leading-[1.1] xl:text-5xl xl:tracking-tighter">The foundation for your vibe.js interface</h1>
      <p class="max-w-3xl text-base text-balance text-foreground sm:text-lg">
        Accessible components adapted from shadcn/ui. Copy them into your app as .vibe source, then shape them to fit your product.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-2 pt-1">
        <RouterLink to="/docs/installation" class="inline-flex h-9 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90">Get started</RouterLink>
        <RouterLink to="/docs/components" class="inline-flex h-9 items-center rounded-md px-4 text-sm font-medium transition-colors hover:bg-accent">Browse components</RouterLink>
      </div>
      <div class="mt-2 flex max-w-full items-center gap-1 rounded-lg border bg-muted/40 py-1 pr-1 pl-3 font-mono text-[0.8125rem]">
        <code class="truncate"><span class="text-muted-foreground select-none" aria-hidden="true">$ </span>{{ command }}</code>
        <CopyButton :value="command" label="Copy install command" />
      </div>
    </section>

    <section class="mx-auto w-full max-w-screen-2xl px-4 pb-24 md:px-6" aria-label="Examples">
      <Tabs v-model="view" class="gap-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <TabsList aria-label="Example screens">
            <TabsTrigger v-for="item in views" :key="item.value" :value="item.value" class="px-3">{{ item.label }}</TabsTrigger>
          </TabsList>
          <Select v-model="theme">
            <SelectTrigger size="sm" class="w-36" aria-label="Preview theme">
              <span class="size-3 rounded-full bg-primary" :style="themeStyle" aria-hidden="true" />
              <SelectValue />
            </SelectTrigger>
            <SelectContent align="end">
              <SelectItem v-for="name in Object.keys(themes)" :key="name" :value="name">{{ name.charAt(0).toUpperCase() + name.slice(1) }}</SelectItem>
            </SelectContent>
          </Select>
        </div>
        <div class="overflow-hidden rounded-xl border bg-background shadow-[0_1px_2px_rgb(0_0_0/0.04),0_12px_40px_-12px_rgb(0_0_0/0.12)] dark:shadow-none" :style="themeStyle">
          <TabsContent v-for="item in views" :key="item.value" :value="item.value" :class="item.inset ? 'bg-muted/30 p-4 sm:p-6' : undefined"><component :is="item.component" /></TabsContent>
        </div>
      </Tabs>
    </section>

    <section class="border-t" aria-labelledby="home-components">
      <div class="mx-auto grid w-full max-w-screen-2xl gap-10 px-4 py-20 md:px-6 lg:grid-cols-[20rem_1fr]">
        <div class="flex flex-col gap-3">
          <h2 id="home-components" class="text-2xl font-semibold tracking-tight">Everything you need, nothing you don't</h2>
          <p class="text-muted-foreground">{{ componentCount }} components with live examples, keyboard support and an API reference. Add only the ones you use.</p>
          <RouterLink to="/docs/cli" class="text-sm font-medium underline underline-offset-4">How the CLI works</RouterLink>
        </div>
        <ul class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5">
          <li v-for="item in components" :key="item.href">
            <RouterLink :to="item.href" class="text-muted-foreground transition-colors hover:text-foreground">{{ item.title }}</RouterLink>
          </li>
        </ul>
      </div>
    </section>

    <section class="border-t bg-muted/30" aria-labelledby="home-start">
      <div class="mx-auto flex w-full max-w-3xl flex-col items-center gap-4 px-4 py-20 text-center">
        <h2 id="home-start" class="text-3xl font-semibold tracking-tighter text-balance sm:text-4xl">Start with one component</h2>
        <p class="max-w-lg text-muted-foreground">Initialize vibecn, add a button, and see it render with your own compiler. Everything after that is your code.</p>
        <div class="flex flex-wrap justify-center gap-2 pt-2">
          <RouterLink to="/docs/installation" class="inline-flex h-9 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90">Read the installation guide</RouterLink>
          <a href="https://github.com/vibejs/vibecn" class="inline-flex h-9 items-center rounded-md border bg-background px-4 text-sm font-medium shadow-xs transition-colors hover:bg-accent">View on GitHub</a>
        </div>
      </div>
    </section>
  </div>
</template>
