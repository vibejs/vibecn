<!-- Adapted from shadcn/ui under MIT. See vibecn.LICENSE. -->
<script setup lang="ts">
import type { ClassValue } from '@usevibejs/ui';
import { cn } from '__VIBECN_UTILS__';

defineOptions({ inheritAttrs: false });

const { class: className, align = 'inline-start' } = defineProps<{
  class?: ClassValue;
  align?: 'inline-start' | 'inline-end' | 'block-start' | 'block-end';
}>();
defineSlots<{ default?: (props: {}) => unknown }>();
const base =
  "flex h-auto cursor-text items-center justify-center gap-2 py-1.5 text-sm font-medium text-muted-foreground select-none group-data-[disabled=true]/input-group:opacity-50 [&>kbd]:rounded-[calc(var(--radius)-5px)] [&>svg:not([class*='size-'])]:size-4";
const aligns = {
  'inline-start': 'order-first pl-3 has-[>button]:ml-[-0.45rem] has-[>kbd]:ml-[-0.35rem]',
  'inline-end': 'order-last pr-3 has-[>button]:mr-[-0.45rem] has-[>kbd]:mr-[-0.35rem]',
  'block-start': 'order-first w-full justify-start px-3 pt-3 group-has-[>input]/input-group:pt-2.5 [.border-b]:pb-3',
  'block-end': 'order-last w-full justify-start px-3 pb-3 group-has-[>input]/input-group:pb-2.5 [.border-t]:pt-3',
};

/** A click on the addon focuses the group's control, unless it lands on a button. */
function focusControl(event: MouseEvent): void {
  const target = event.target as HTMLElement;
  if (target.closest('button')) return;
  (event.currentTarget as HTMLElement).parentElement?.querySelector<HTMLElement>('input, textarea')?.focus();
}
</script>

<template>
  <div role="group" data-slot="input-group-addon" :data-align="align" v-bind="$attrs" :class="cn(base, aligns[align], className)" @click="focusControl"><slot /></div>
</template>
