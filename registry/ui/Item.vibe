<script setup lang="ts">
import type { ClassValue } from '@usevibejs/ui';
import { cn } from '__VIBECN_UTILS__';

defineOptions({ inheritAttrs: false });

const { class: className, variant = 'default', size = 'default' } = defineProps<{
  class?: ClassValue;
  variant?: 'default' | 'outline' | 'muted';
  size?: 'default' | 'sm';
}>();
defineSlots<{ default?: (props: {}) => unknown }>();
const variants = {
  default: 'bg-transparent',
  outline: 'border-border',
  muted: 'bg-muted/50',
};
const sizes = {
  default: 'gap-4 p-4',
  sm: 'gap-2.5 px-4 py-3',
};
</script>

<template>
  <div data-slot="item" :data-variant="variant" :data-size="size" v-bind="$attrs" :class="cn('group/item flex flex-wrap items-center rounded-md border border-transparent text-sm transition-colors duration-100 outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50', variants[variant], sizes[size], className)"><slot /></div>
