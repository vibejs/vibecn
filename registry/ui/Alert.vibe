<script setup lang="ts">
import type { ClassValue } from '@usevibejs/ui';
import { cn } from '__VIBECN_UTILS__';

defineOptions({ inheritAttrs: false });

const { class: className, variant = 'default' } = defineProps<{
  class?: ClassValue;
  variant?: 'default' | 'destructive';
}>();
defineSlots<{ default?: (props: {}) => unknown }>();
const variants = {
  default: 'bg-card text-card-foreground',
  destructive: 'bg-card text-destructive *:data-[slot=alert-description]:text-destructive/90 [&>svg]:text-current',
};
</script>

<template>
  <div data-slot="alert" role="alert" :data-variant="variant" v-bind="$attrs" :class="cn('relative grid w-full grid-cols-[0_1fr] items-start gap-y-0.5 rounded-lg border px-4 py-3 text-sm has-[>svg]:grid-cols-[calc(var(--spacing)*4)_1fr] has-[>svg]:gap-x-3 [&>svg]:size-4 [&>svg]:translate-y-0.5 [&>svg]:text-current', variants[variant], className)"><slot /></div>
</template>
