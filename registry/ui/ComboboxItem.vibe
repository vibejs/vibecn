<!-- Adapted from shadcn/ui under MIT. See vibecn.LICENSE. -->
<script setup lang="ts">
import { computed, onMounted, onUnmounted, useId, useTemplateRef } from '@usevibejs/ui';
import type { ClassValue, Ref } from '@usevibejs/ui';
import { injectOverlay } from '__VIBECN_LIB__/overlay.ts';
import { cn } from '__VIBECN_UTILS__';

defineOptions({ inheritAttrs: false });

const { class: className, value, disabled = false } = defineProps<{
  class?: ClassValue;
  value: string;
  disabled?: boolean;
}>();
defineSlots<{ default?: (props: {}) => unknown }>();
const combobox = injectOverlay<{
  list: string;
  model: Ref<string>;
  search: Ref<string>;
  filtering: Ref<boolean>;
  labels: Map<string, string>;
  active: Ref<string>;
  activate: (option: HTMLElement) => void;
  reset: () => void;
  onKeydown: (event: KeyboardEvent) => boolean;
  select: (value: string) => void;
}>('Combobox');
const id = useId();
const item = useTemplateRef<HTMLElement>('item');
const label = useTemplateRef<HTMLElement>('label');
onMounted(() => combobox.labels.set(value, label.value!.textContent!.trim()));
onUnmounted(() => combobox.labels.delete(value));
const visible = computed(() => {
  const query = combobox.search.value.trim().toLowerCase();
  return !combobox.filtering.value || !query || (combobox.labels.get(value) ?? value).toLowerCase().includes(query);
});

function choose(): void {
  if (!disabled) combobox.select(value);
}
function onPointerMove(): void {
  if (!disabled) combobox.activate(item.value!);
}
const base =
  "relative flex w-full cursor-default items-center gap-2 rounded-sm py-1.5 pr-8 pl-2 text-sm outline-hidden select-none data-[highlighted]:bg-accent data-[highlighted]:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4";
</script>

<template>
  <div
    ref="item"
    role="option"
    data-slot="combobox-item"
    :id="id"
    :hidden="!visible"
    :aria-selected="combobox.model.value === value"
    :data-highlighted="combobox.active.value === id || undefined"
    :data-disabled="disabled || undefined"
    :aria-disabled="disabled || undefined"
    v-bind="$attrs"
    :class="cn(base, className)"
    @pointermove="onPointerMove"
    @pointerdown.prevent
    @click="choose"
  >
    <span ref="label" class="flex items-center gap-2"><slot /></span>
    <span data-slot="combobox-item-indicator" class="pointer-events-none absolute right-2 flex size-4 items-center justify-center">
      <svg v-if="combobox.model.value === value" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4"><path d="M20 6 9 17l-5-5" /></svg>
    </span>
  </div>
</template>
