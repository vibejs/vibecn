<script setup lang="ts">
import type { ClassValue } from '@usevibejs/ui';
import Button from './Button.vibe';

defineOptions({ inheritAttrs: false });

const { class: className, variant = 'ghost', size = 'icon-xs', disabled = false } = defineProps<{
  class?: ClassValue;
  variant?: 'default' | 'secondary' | 'destructive' | 'outline' | 'ghost' | 'link';
  size?: 'default' | 'xs' | 'sm' | 'lg' | 'icon' | 'icon-xs' | 'icon-sm' | 'icon-lg';
  disabled?: boolean;
}>();
defineSlots<{ default?: (props: {}) => unknown }>();
</script>

<template>
  <Button data-slot="attachment-action" :variant="variant" :size="size" :disabled="disabled" v-bind="$attrs" :class="className"><slot /></Button>
</template>
