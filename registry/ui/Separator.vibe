<template>
  <div data-slot="separator" v-bind="$attrs" :data-orientation="orientation" :role="decorative ? 'none' : 'separator'" :aria-orientation="decorative ? undefined : orientation" :aria-hidden="decorative ? 'true' : undefined" :class="cn('shrink-0 bg-border', orientation === 'horizontal' ? 'h-px w-full' : 'h-full w-px', className)" />
