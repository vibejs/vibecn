<!-- Adapted from shadcn/ui under MIT. See vibecn.LICENSE. -->
<script setup lang="ts">
import { onMounted, onUnmounted, useTemplateRef } from '@usevibejs/ui';
import type { ClassValue, Ref } from '@usevibejs/ui';
import { anchorOf, injectOverlay } from '__VIBECN_LIB__/overlay.ts';
import { cn } from '__VIBECN_UTILS__';

defineOptions({ inheritAttrs: false });

const { class: className, value, disabled = false } = defineProps<{
  class?: ClassValue;
  value: string;
  disabled?: boolean;
}>();
defineSlots<{ default?: (props: {}) => unknown }>();
const select = injectOverlay<{
  model: Ref<string>;
  labels: Map<string, string>;
}>('Select');
const label = useTemplateRef<HTMLElement>('label');
onMounted(() => select.labels.set(value, label.value!.textContent!.trim()));
onUnmounted(() => select.labels.delete(value));

function choose(): void {
  if (disabled) return;
  select.model.value = value;
  select.open.value = false;
  (anchorOf(select.id) as HTMLElement).focus();
}
function onKeydown(event: KeyboardEvent): void {
  if (event.key !== 'Enter' && event.key !== ' ') return;
  event.preventDefault();
  choose();
}
function onPointerMove(event: PointerEvent): void {
  if (!disabled) (event.currentTarget as HTMLElement).focus();
}
const base =
  "relative flex w-full cursor-default items-center gap-2 rounded-sm py-1.5 pr-8 pl-2 text-sm outline-hidden select-none focus:bg-accent focus:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 [&_svg:not([class*='text-'])]:text-muted-foreground";
</script>

<template>
  <div
    role="option"
    tabindex="-1"
    data-slot="select-item"
    :aria-selected="select.model.value === value"
    :data-state="select.model.value === value ? 'checked' : 'unchecked'"
    :data-disabled="disabled || undefined"
    :aria-disabled="disabled || undefined"
    v-bind="$attrs"
    :class="cn(base, className)"
    @click="choose"
    @keydown="onKeydown"
    @pointermove="onPointerMove"
  >
    <span data-slot="select-item-indicator" class="absolute right-2 flex size-3.5 items-center justify-center">
      <svg v-if="select.model.value === value" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4"><path d="M20 6 9 17l-5-5" /></svg>
    </span>
    <span ref="label" class="flex items-center gap-2"><slot /></span>
  </div>
</template>
