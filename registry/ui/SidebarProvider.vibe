<!-- Adapted from shadcn/ui under MIT. See vibecn.LICENSE. -->
<script setup lang="ts">
import { onMounted, onUnmounted, provide, ref, useId, watch } from '@usevibejs/ui';
import type { ClassValue } from '@usevibejs/ui';
import { cn } from '__VIBECN_UTILS__';

defineOptions({ inheritAttrs: false });
const { class: className, storageKey } = defineProps<{ class?: ClassValue; storageKey?: string }>();
const open = defineModel<boolean>('open', { default: () => true });
const openMobile = defineModel<boolean>('openMobile', { default: () => false });
defineSlots<{ default?: (props: {}) => unknown }>();
const mobile = ref(false);
const id = useId();
const toggle = (): void => { if (mobile.value) openMobile.value = !openMobile.value; else open.value = !open.value; };
provide(Symbol.for('vibecn.sidebar'), { open, openMobile, mobile, id, toggle });
let media: MediaQueryList;
function onMedia(): void { mobile.value = media.matches; openMobile.value = false; }
function onKeydown(event: KeyboardEvent): void {
  if (event.key.toLowerCase() !== 'b' || (!event.metaKey && !event.ctrlKey) || event.altKey || event.defaultPrevented || (event.target instanceof Element && event.target.closest('input, textarea, select, [contenteditable="true"]'))) return;
  event.preventDefault();
  toggle();
}
onMounted(() => {
  media = matchMedia('(max-width: 767px)');
  mobile.value = media.matches;
  media.addEventListener('change', onMedia);
  window.addEventListener('keydown', onKeydown);
  if (storageKey) {
    try {
      const stored = localStorage.getItem(storageKey);
      if (stored === 'true' || stored === 'false') open.value = stored === 'true';
    } catch { /* Storage can be unavailable in embedded or private contexts. */ }
  }
});
watch(open, (value) => {
  if (storageKey) { try { localStorage.setItem(storageKey, String(value)); } catch { /* State still works without persistence. */ } }
});
onUnmounted(() => { media?.removeEventListener('change', onMedia); window.removeEventListener('keydown', onKeydown); });
</script>

<template>
  <div data-slot="sidebar-wrapper" v-bind="$attrs" :class="cn('group/sidebar-wrapper flex min-h-svh w-full has-data-[variant=inset]:bg-sidebar [--sidebar-width:16rem] [--sidebar-width-icon:3rem]', className)"><slot /></div>
</template>
