<script setup lang="ts">
import { provideOverlay, useDelayedOpen } from '__VIBECN_LIB__/overlay.ts';

const { delayDuration = 0, closeDelay = 0 } = defineProps<{
  /** Milliseconds before the tooltip opens on hover. Focus opens it at once. */
  delayDuration?: number;
  closeDelay?: number;
}>();
const open = defineModel<boolean>('open', { default: () => false });
defineSlots<{ default?: (props: {}) => unknown }>();
provideOverlay('Tooltip', open, useDelayedOpen(open, () => ({ open: delayDuration, close: closeDelay })));
</script>

<template>
  <slot />
</template>
