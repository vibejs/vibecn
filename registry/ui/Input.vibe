<!-- Adapted from shadcn/ui under MIT. See vibecn.LICENSE. -->
<script setup lang="ts">
import { computed, useAttrs, useTemplateRef } from '@usevibejs/ui';
import type { ClassValue } from '@usevibejs/ui';
import { cn } from '__VIBECN_UTILS__';

defineOptions({ inheritAttrs: false });

const { class: className, type = 'text', name, placeholder, disabled, required, readonly, autocomplete } = defineProps<{
  class?: ClassValue;
  type?: 'text' | 'email' | 'password' | 'search' | 'tel' | 'url';
  name?: string;
  placeholder?: string;
  disabled?: boolean;
  required?: boolean;
  readonly?: boolean;
  autocomplete?: string;
}>();
const model = defineModel<string>({ default: () => '' });
const field = useTemplateRef<HTMLInputElement>('field');
defineExpose({ focus: () => field.value?.focus() });
const attrs = useAttrs();
const inputAttrs = computed(() => ({ ...attrs, name, placeholder, disabled, required, readonly, autocomplete, class: cn('h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs outline-none transition-[color,box-shadow] placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20', className) }));
</script>

<template>
  <!-- The compiler rejects v-model with a bound :type (VIBE2507); one static input per type keeps v-model's IME handling. -->
  <input v-if="type === 'email'" type="email" ref="field" v-bind="inputAttrs" v-model="model" data-slot="input" />
  <input v-else-if="type === 'password'" type="password" ref="field" v-bind="inputAttrs" v-model="model" data-slot="input" />
  <input v-else-if="type === 'search'" type="search" ref="field" v-bind="inputAttrs" v-model="model" data-slot="input" />
  <input v-else-if="type === 'tel'" type="tel" ref="field" v-bind="inputAttrs" v-model="model" data-slot="input" />
  <input v-else-if="type === 'url'" type="url" ref="field" v-bind="inputAttrs" v-model="model" data-slot="input" />
  <input v-else type="text" ref="field" v-bind="inputAttrs" v-model="model" data-slot="input" />
</template>
