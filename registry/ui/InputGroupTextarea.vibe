<!-- Adapted from shadcn/ui under MIT. See vibecn.LICENSE. -->
<script setup lang="ts">
import { useTemplateRef } from '@usevibejs/ui';
import type { ClassValue } from '@usevibejs/ui';
import { cn } from '__VIBECN_UTILS__';
import Textarea from './Textarea.vibe';

defineOptions({ inheritAttrs: false });

const { class: className, rows, name, placeholder, disabled, required, readonly, autocomplete } = defineProps<{
  class?: ClassValue;
  rows?: number;
  name?: string;
  placeholder?: string;
  disabled?: boolean;
  required?: boolean;
  readonly?: boolean;
  autocomplete?: string;
}>();
const model = defineModel<string>({ default: () => '' });
const textarea = useTemplateRef<{ focus: () => void }>('textarea');
defineExpose({ focus: () => textarea.value?.focus() });
</script>

<template>
  <Textarea
    ref="textarea"
    v-model="model"
    data-slot="input-group-control"
    :rows="rows"
    :name="name"
    :placeholder="placeholder"
    :disabled="disabled"
    :required="required"
    :readonly="readonly"
    :autocomplete="autocomplete"
    v-bind="$attrs"
    :class="cn('flex-1 resize-none rounded-none border-0 bg-transparent py-3 shadow-none focus-visible:ring-0 dark:bg-transparent', className)"
  />
</template>
