<!-- Adapted from shadcn/ui under MIT. See vibecn.LICENSE. -->
<script setup lang="ts">
import type { ClassValue } from '@usevibejs/ui';
import { injectOverlay, type DelayedOpen } from '__VIBECN_LIB__/overlay.ts';
import Button from './Button.vibe';

defineOptions({ inheritAttrs: false });

const {
  class: className,
  variant = 'default',
  size = 'default',
  disabled = false,
} = defineProps<{
  class?: ClassValue;
  variant?: 'default' | 'secondary' | 'destructive' | 'outline' | 'ghost' | 'link';
  size?: 'default' | 'xs' | 'sm' | 'lg' | 'icon' | 'icon-xs' | 'icon-sm' | 'icon-lg';
  disabled?: boolean;
}>();
defineSlots<{ default?: (props: {}) => unknown }>();
const overlay = injectOverlay<DelayedOpen>('Tooltip');
// Keyboard focus shows the tooltip at once; a press or Escape hides it without moving focus.
const onFocus = (event: FocusEvent): void => {
  if ((event.target as Element).matches(':focus-visible')) overlay.open.value = true;
};
const hide = (): void => {
  overlay.open.value = false;
};
const onKeydown = (event: KeyboardEvent): void => {
  if (event.key === 'Escape') hide();
};
</script>

<template>
  <Button
    data-slot="tooltip-trigger"
    :aria-describedby="overlay.open.value ? overlay.id + '-content' : undefined"
    :data-state="overlay.open.value ? 'open' : 'closed'"
    :data-anchor="overlay.id"
    :variant="variant"
    :size="size"
    :disabled="disabled"
    v-bind="$attrs"
    :class="className"
    @pointerenter="overlay.show"
    @pointerleave="overlay.hide"
    @focus="onFocus"
    @blur="hide"
    @pointerdown="hide"
    @keydown="onKeydown"
  ><slot /></Button>
</template>
