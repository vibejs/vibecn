<script setup lang="ts">
import type { ClassValue } from '@usevibejs/ui';
import { cn } from '__VIBECN_UTILS__';
import Button from './Button.vibe';

defineOptions({ inheritAttrs: false });

const {
  class: className,
  variant = 'ghost',
  size = 'xs',
  type = 'button',
  disabled = false,
} = defineProps<{
  class?: ClassValue;
  variant?: 'default' | 'secondary' | 'destructive' | 'outline' | 'ghost' | 'link';
  size?: 'xs' | 'sm' | 'icon-xs' | 'icon-sm';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
}>();
defineSlots<{ default?: (props: {}) => unknown }>();
const sizes = {
  xs: "h-6 gap-1 rounded-[calc(var(--radius)-5px)] px-2 has-[>svg]:px-2 [&>svg:not([class*='size-'])]:size-3.5",
  sm: 'h-8 gap-1.5 rounded-md px-2.5 has-[>svg]:px-2.5',
  'icon-xs': 'size-6 rounded-[calc(var(--radius)-5px)] p-0 has-[>svg]:p-0',
  'icon-sm': 'size-8 p-0 has-[>svg]:p-0',
};
</script>

<template>
  <Button :type="type" :variant="variant" :disabled="disabled" :data-size="size" v-bind="$attrs" :class="cn('flex items-center gap-2 text-sm shadow-none', sizes[size], className)"><slot /></Button>
</template>
