<!-- Adapted from shadcn/ui under MIT. See vibecn.LICENSE. -->
<script setup lang="ts">
import { useTemplateRef } from '@usevibejs/ui';
import type { ClassValue } from '@usevibejs/ui';
import { anchorOf, injectOverlay, useFloating, usePopover } from '__VIBECN_LIB__/overlay.ts';
import type { DelayedOpen } from '__VIBECN_LIB__/overlay.ts';
import { cn } from '__VIBECN_UTILS__';

defineOptions({ inheritAttrs: false });

const {
  class: className,
  side = 'bottom',
  align = 'center',
  sideOffset = 4,
  alignOffset = 0,
} = defineProps<{
  class?: ClassValue;
  side?: 'top' | 'right' | 'bottom' | 'left';
  align?: 'start' | 'center' | 'end';
  sideOffset?: number;
  alignOffset?: number;
}>();
defineSlots<{ default?: (props: {}) => unknown }>();
const overlay = injectOverlay<DelayedOpen>('HoverCard');
const content = useTemplateRef<HTMLElement>('content');
const onToggle = usePopover(content, overlay.open);
const placed = useFloating(
  () => anchorOf(overlay.id),
  content,
  () => overlay.open.value,
  () => ({ side, align, sideOffset, alignOffset }),
);
</script>

<template>
  <div
    ref="content"
    data-slot="hover-card-content"
    :id="overlay.id + '-content'"
    :data-state="overlay.open.value ? 'open' : 'closed'"
    :data-side="placed"
    :data-align="align"
    v-bind="{ popover: 'manual', ...$attrs }"
    :class="cn('w-64 rounded-md border bg-popover p-4 text-popover-foreground shadow-md outline-hidden fixed inset-auto m-0 transition-[opacity,scale,translate,overlay,display] transition-discrete duration-150 opacity-0 scale-95 open:opacity-100 open:scale-100 starting:open:opacity-0 starting:open:scale-95 data-[side=bottom]:starting:open:-translate-y-2 data-[side=top]:starting:open:translate-y-2 data-[side=left]:starting:open:translate-x-2 data-[side=right]:starting:open:-translate-x-2 motion-reduce:transition-none', className)"
    @beforetoggle="onToggle"
    @pointerenter="overlay.show"
    @pointerleave="overlay.hide"
    @focusin="overlay.show"
    @focusout="overlay.hide"
  ><slot /></div>
</template>
