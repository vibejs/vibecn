<!-- Adapted from shadcn/ui under MIT. See vibecn.LICENSE. -->
<script setup lang="ts">
import type { ClassValue } from '@usevibejs/ui';
import { injectOverlay } from '__VIBECN_LIB__/overlay.ts';
import Button from './Button.vibe';

defineOptions({ inheritAttrs: false });

const {
  class: className,
  variant = 'default',
  size = 'default',
  disabled = false,
} = defineProps<{
  class?: ClassValue;
  variant?: 'default' | 'secondary' | 'destructive' | 'outline' | 'ghost' | 'link';
  size?: 'default' | 'xs' | 'sm' | 'lg' | 'icon' | 'icon-xs' | 'icon-sm' | 'icon-lg';
  disabled?: boolean;
}>();
defineSlots<{ default?: (props: {}) => unknown }>();
const overlay = injectOverlay('Popover');
</script>

<template>
  <!-- popovertarget lets the browser toggle the popover and handle light dismiss on this button. -->
  <Button
    data-slot="popover-trigger"
    aria-haspopup="dialog"
    :aria-expanded="overlay.open.value"
    :data-state="overlay.open.value ? 'open' : 'closed'"
    :data-anchor="overlay.id"
    :popovertarget="overlay.id + '-content'"
    :variant="variant"
    :size="size"
    :disabled="disabled"
    v-bind="$attrs"
    :class="className"
  ><slot /></Button>
</template>
