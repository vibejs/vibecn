{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2024", "dom"],
    "module": "nodenext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": ".tsbuild/tools",
    "types": ["node"]
  },
  "include": [
    "src",
    "scripts",
    "test",
    "*.config.ts",
    "registry/lib",
    "site/plugins",
    "site/vite.config.ts",
    "site/src/site/types.ts"
  ],
  "exclude": ["test/components.vibe.test.ts"]
}
